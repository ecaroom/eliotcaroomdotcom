</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('button.doc').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.querySelector<HTMLDialogElement>(`#doc-${btn.dataset.doc}`)?.showModal();
    });
  });
  document.querySelectorAll<HTMLDialogElement>('dialog.sidecar').forEach((dlg) => {
    dlg.querySelector('.sc-close')?.addEventListener('click', () => dlg.close());
    // click on the dimmed backdrop closes the panel
    dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
  });
</script>
