---
import Base from '../layouts/Base.astro';

// Campaign page for the November 2026 Roselle Park mayoral and council races.
// Every figure checked 2026-09-26 against the linked document. Budget figures are
// Sheet 17, Current Fund, Unclassified, line 31-430-2 (Electricity), "Paid or Charged."
const pdf = (id: number, name: string) => `https://www.rosellepark.gov/DocumentCenter/View/${id}/${name}`;

// Electricity line, paid or charged, by year. 2026 is the appropriation in the introduced budget, not spending
// (the adopted 2026 budget is posted only as scanned images).
// 2023 comes from the 2023 audit because the 2024 budget PDF is a scan with no text.
const bars = [
  { year: 2021, value: 94214.59, doc: 'b2022', label: true },
  { year: 2022, value: 90226.58, doc: 'b2023' },
  { year: 2023, value: 100156.6, doc: 'a2023' },
  { year: 2024, value: 113548.61, doc: 'b2025' },
  { year: 2025, value: 124730.35, doc: 'b2026', label: true },
  { year: 2026, value: 142000, doc: 'b2026', label: true, budgeted: true },
];
// PSE&G rate lines on the spending chart. Set to false to remove them (Eliot may undo this).
const showRates = true;

// PSE&G bundled energy rate, cents per kWh, base/winter tier, from the filed tariffs charted on
// /solar/pseg-rates/ (NREL/OpenEI URDB). GLP = commercial "General Lighting and Power", excludes
// the separate demand charge; RS = residential. Each entry is [effective date, rate].
const tariffUrl = 'https://nj.pseg.com/-/media/pseg/public-site/documents/current-electric-tariff/';
const filings = [
  { eff: '2019-06-01', glp: 6.575, rs: 17.151, src: tariffUrl + 'electric_tariff.ashx' },
  { eff: '2021-06-01', glp: 6.211, rs: 17.827, src: tariffUrl + 'electric_tariff.ashx' },
  { eff: '2022-06-15', glp: 8.132, rs: 17.508, src: tariffUrl + 'electric-tariff-16-2021-gprc-w-community-solar-energy-prog-effective-07012022.ashx' },
  { eff: '2023-05-01', glp: 9.831, rs: 18.891, src: tariffUrl + 'electric-tariff-16-bpu-bgs-nitstec-effective-09012023.ashx' },
  { eff: '2025-01-01', glp: 18.475, rs: 23.18, src: tariffUrl + 'electric-tariff-17-gprc-effective-20250101.ashx' },
  { eff: '2026-04-01', glp: 19.369, rs: 25.876, src: tariffUrl + 'electric-tariff-17-sprc-effective-20260401.ashx' },
];
const tariffs = {
  glp: filings.map((f) => [f.eff, f.glp] as const),
  rs: filings.map((f) => [f.eff, f.rs] as const),
};
const longDate = (iso: string) => new Date(iso + 'T12:00:00Z').toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
// Average rate in effect across the calendar year, weighted by days; 2026 runs through the build date.
const yearAvg = (series: readonly (readonly [string, number])[], year: number) => {
  const day = 86400000;
  const start = Date.UTC(year, 0, 1);
  const end = Math.min(Date.UTC(year, 11, 31), Date.now());
  let total = 0, n = 0;
  for (let t = start; t <= end; t += day) {
    let v = series[0][1];
    for (const [eff, r] of series) if (Date.parse(eff) <= t) v = r;
    total += v; n++;
  }
  return total / n;
};
const rateMax = 30;
const rateTicks = [10, 20, 30];
const cents = (n: number) => n.toFixed(1) + '¢';
// yellow to red across the years, one stop per bar
const heat = (i: number, n: number) => `color-mix(in oklab, var(--hot) ${Math.round((i / (n - 1)) * 100)}%, var(--warm))`;

const axisMax = 150000;
const ticks = [50000, 100000, 150000];
const rates = bars.map((b) => ({ glp: yearAvg(tariffs.glp, b.year), rs: yearAvg(tariffs.rs, b.year) }));
const xPct = (i: number) => ((i + 0.5) / bars.length) * 100;
const yPct = (c: number) => (c / rateMax) * 100;
const linePts = (key: 'glp' | 'rs') => rates.map((r, i) => `${xPct(i).toFixed(2)},${(100 - yPct(r[key])).toFixed(2)}`).join(' ');
const usd = (n: number) => '$' + Math.round(n).toLocaleString('en-US');
const k = (n: number) => '$' + Math.round(n / 1000) + 'k';

// Documents that open in the side panel: long PDFs where the figure is buried.
const docs = [
  {
    id: 'b2026',
    title: 'Roselle Park 2026 Introduced Budget',
    href: pdf(678, '2026-Introduced-Budget-PDF'),
    where: 'Sheet 17, Current Fund appropriations, Unclassified, line 31-430-2, Electricity.',
    rows: [
      ['2025 budget, as adopted', '$115,000.00'],
      ['2025 budget, as modified', '$140,000.00'],
      ['2025 paid or charged', '$124,730.35'],
      ['2025 unexpended, reserved', '$15,269.65'],
      ['2026 appropriation', '$142,000.00'],
    ],
    note: 'The adopted 2026 budget is posted only as scanned images, so this is the introduced version. Street Lighting is a separate line on the same sheet (31-435-2): $229,472.28 paid or charged in 2025, $259,000.00 appropriated for 2026.',
  },
  {
    id: 'b2025',
    title: 'Roselle Park 2025 Introduced Budget',
    href: pdf(244, '2025-Introduced-Budget-PDF'),
    where: 'Sheet 17, Current Fund appropriations, Unclassified, line 31-430-2, Electricity.',
    rows: [
      ['2024 budget, as adopted', '$105,000.00'],
      ['2024 budget after modification', '$120,000.00'],
      ['2024 paid or charged', '$113,548.61'],
      ['2025 appropriation', '$115,000.00'],
    ],
    note: 'Street Lighting is a separate line on the same sheet (31-435-2): $213,037.47 paid or charged in 2024.',
  },
  {
    id: 'b2023',
    title: 'Roselle Park 2023 Adopted Budget',
    href: pdf(240, '2023-Adopted-Budget-PDF'),
    where: 'Sheet 17, Current Fund appropriations, Unclassified, line 31-430-2, Electricity.',
    rows: [
      ['2022 paid or charged', '$90,226.58'],
      ['2023 appropriation', '$105,000.00'],
    ],
  },
  {
    id: 'b2022',
    title: 'Roselle Park 2022 Adopted Budget',
    href: pdf(238, '2022-Adopted-Budget-PDF'),
    where: 'Sheet 17, line 31-430-2, Electricity.',
    rows: [['2021 paid or charged', '$94,214.59'], ['2022 appropriation', '$119,000.00']],
  },
  {
    id: 'a2023',
    title: 'Roselle Park Report of Audit, 2023',
    href: 'https://www.rosellepark.gov/Archive.aspx?ADID=86',
    where: 'Suplee, Clooney & Company, audit of the year ended December 31, 2023. Exhibit A-3, Current Fund Statement of Expenditures, Utilities, Electricity.',
    rows: [
      ['2023 budget', '$105,000.00'],
      ['2023 budget after modification', '$115,000.00'],
      ['2023 paid or charged', '$100,156.60'],
      ['2023 unexpended, reserved', '$14,843.40'],
    ],
    note: 'The 2024 budget, which would normally report 2023 spending, is posted only as scanned images, so the audit is the source for this year.',
  },
  {
    id: 'adi',
    title: 'NJ Board of Public Utilities Order, May 21, 2026',
    href: 'https://www.nj.gov/bpu/pdf/boardorders/2026/20260521/8C%20ORDER%20ADI%203%20Year%20Review%20Cost%20Cap.pdf',
    where: 'Three-year review of the Administratively Determined Incentive (ADI) program, Docket Nos. QO20020184 and QO26030096. Staff recommended no change to non-residential incentives; the Board accepted it.',
    rows: [
      ['Net-metered non-residential, rooftop, carport, canopy or floating, under 1 MW', '$110 per SREC-II'],
      ['Incentive term', '15 years'],
    ],
    note: 'One SREC-II is earned per megawatt-hour of solar generation.',
  },
];

const ext = { class: 'ext-inline', target: '_blank', rel: 'noopener' };

const races = [
  {
    office: 'Mayor',
    lead: true,
    seats: [
      { name: 'Joseph Signorello Jr.', party: 'Democrat', note: 'incumbent' },
      { name: 'Khanjan Patel', party: 'Republican' },
    ],
  },
  {
    office: 'Borough Council, At-Large',
    seats: [
      { name: 'Adolfo Dicosmo', party: 'Democrat' },
      { name: 'Jorge Ramirez', party: 'Republican' },
    ],
  },
  {
    office: 'Borough Council, 1st Ward',
    seats: [
      { name: 'Jorge E. Casalins', party: 'Democrat' },
      { name: 'Mariann Brenner', party: 'Republican' },
    ],
  },
];

const questions = [
  'Will you have every roof and parking lot we own assessed for solar by February 28, 2027?',
  'Will you pursue at least 100 kilowatts of solar, on one or more sites, that can be in service by December 31, 2027, so we can collect the federal clean electricity investment credit?',
  'Will you favor financing that costs taxpayers nothing up front, such as a power purchase agreement or New Jersey’s Energy Savings Improvement Program?',
  'Will you publish our annual electricity use and spending?',
  'In a sentence or two, what would you do to protect us from rising energy costs and from storms like Sandy, Irene, and Ida?',
];
---
<Base
  title="Common Sense Solar Savings for Roselle Park, NJ"
  description="Our electricity spending in Roselle Park rose 32% from 2021 to 2025. Solar on the property we own can cut it, at no upfront cost, and federal money for it ends in 2027."
>
  <h1>Common Sense Solar Savings for Roselle Park, NJ</h1>
  <p class="meta">For the November 2026 election · updated September 2026</p>

  <p>
    As a resident of Roselle Park, I’m urging candidates for mayor and borough council to pledge to pursue solar on
    borough properties.
  </p>
  <p>
    Roselle Park will benefit from adding solar to borough properties. It’s the right financial choice to hedge against
    rising electric rates, and the right thing to do as climate causes worsening damage in New Jersey and beyond.
  </p>

  <h2>Escalating Electric Costs Can Be Mitigated with Solar</h2>
  <p>
    Our electricity spending rose 32% from 2021 to 2025, according to our own budgets (<button class="doc" data-doc="b2022">2021</button>, <button class="doc" data-doc="b2026">2025</button>).
  </p>

  <figure class="spend" aria-labelledby="spend-cap">
    <figcaption id="spend-cap">{showRates ? 'Our spending on electricity, paid or charged, and PSE&G’s rates' : 'Our spending on electricity, paid or charged'}</figcaption>
    {showRates && (
      <ul class="legend">
        <li><span class="key key-bar"></span>Our electricity spending (left scale)</li>
        <li><span class="key key-line"></span>PSE&amp;G commercial rate, ¢/kWh (right scale)</li>
        <li><span class="key key-line dashed"></span>PSE&amp;G residential rate, ¢/kWh (right scale)</li>
      </ul>
    )}
    <div class={`plot${showRates ? ' with-rates' : ''}`} role="img" aria-label={'Electricity spending by year: 2021 $94,215; 2022 $90,227; 2023 $100,157; 2024 $113,549; 2025 $124,730; 2026 budgeted $142,000.' + (showRates ? ' PSE&G average commercial rate: ' + bars.map((b, i) => `${b.year} ${cents(rates[i].glp)}`).join('; ') + '. Residential: ' + bars.map((b, i) => `${b.year} ${cents(rates[i].rs)}`).join('; ') + '.' : '')}>
      {ticks.map((t, i) => (
        <div class="tick" style={`bottom:${(t / axisMax) * 100}%`}><span>{k(t)}</span>{showRates && <span class="r">{rateTicks[i]}¢</span>}</div>
      ))}
      <div class="cols">
        {bars.map((b) => (
          <div class={`col${b.budgeted ? ' budgeted' : ''}${b.value === null ? ' missing' : ''}`} tabindex={b.value === null ? undefined : 0}>
            {b.value !== null ? (
              <>
                <div class="bar" style={`height:${(b.value / axisMax) * 100}%`}>
                  {b.label && <span class="val">{k(b.value)}</span>}
                </div>
                <span class="tip" role="tooltip">
                  {b.year} · {usd(b.value)}{b.budgeted ? ' budgeted' : ''}
                  {showRates && <><br />commercial {cents(rates[bars.indexOf(b)].glp)} · residential {cents(rates[bars.indexOf(b)].rs)}</>}
                </span>
              </>
            ) : (
              <span class="gap">n/a</span>
            )}
            <span class="yr">{'’' + String(b.year).slice(2) + (b.budgeted ? '*' : '')}</span>
          </div>
        ))}
      </div>
      {showRates && (
        <>
          <svg class="rates" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
            <defs>
              <linearGradient id="heat" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="100" y2="0">
                <stop offset="0%" stop-color="var(--warm)" />
                <stop offset="100%" stop-color="var(--hot)" />
              </linearGradient>
            </defs>
            {(['rs', 'glp'] as const).map((key) => (
              <>
                <polyline class="halo" points={linePts(key)} vector-effect="non-scaling-stroke" />
                <polyline class={`line ${key}`} points={linePts(key)} vector-effect="non-scaling-stroke" />
              </>
            ))}
          </svg>
          {rates.map((r, i) => (
            <>
              <span class="dot rs" style={`left:${xPct(i)}%;bottom:${yPct(r.rs)}%;--c:${heat(i, bars.length)}`}></span>
              <span class="dot glp" style={`left:${xPct(i)}%;bottom:${yPct(r.glp)}%;--c:${heat(i, bars.length)}`}></span>
            </>
          ))}
        </>
      )}
    </div>
    <p class="fignote">
      *2026 is the amount budgeted, not spent.{showRates && ' Rates are each year’s average, weighted by days in effect; 2026 is year to date. The commercial rate excludes PSE&G’s separate demand charge.'} <button class="doc" data-doc="all">Where each number comes from</button>
    </p>
    <details class="asTable">
      <summary>Show as a table</summary>
      <table>
        <thead><tr><th>Year</th><th class="num">Paid or charged</th>{showRates && <><th class="num">Commercial ¢/kWh</th><th class="num">Residential ¢/kWh</th></>}<th>Source</th></tr></thead>
        <tbody>
          {bars.map((b) => (
            <tr>
              <td>{b.year}</td>
              <td class="num">{usd(b.value) + (b.budgeted ? ' (budgeted)' : '')}</td>
              {showRates && <><td class="num">{cents(rates[bars.indexOf(b)].glp)}</td><td class="num">{cents(rates[bars.indexOf(b)].rs)}</td></>}
              <td><button class="doc" data-doc={b.doc}>{docs.find((d) => d.id === b.doc)!.title.replace('Roselle Park ', '')}</button></td>
            </tr>
          ))}
        </tbody>
      </table>
      {showRates && <p class="fignote">Rates: <button class="doc" data-doc="pseg">PSE&amp;G tariff filings</button></p>}
    </details>
  </figure>

  <p>
    PSE&amp;G’s standard commercial energy rate nearly doubled in January 2025, according to its <a href="/solar/pseg-rates/">filed tariffs</a>.
    That year we had to raise our electricity budget from $115,000 to $140,000 partway through. For 2026 we have
    set aside $142,000, 14% more than we spent in 2025.
  </p>
  <p>
    Solar on our roofs and parking lots offsets this line. It would not touch street lighting, a separate and larger
    line that PSE&amp;G bills <a href="https://nj.pseg.com/businessandcontractorservices/outdoorlightingunmeteredservices" {...ext}>without a meter</a>.
  </p>

  <h2>No Upfront Cost If We Build Before 2028</h2>
  <p>
    New Jersey lets towns pay for solar out of the savings, through the <a href="https://www.sustainablejersey.com/fileadmin/media/Grants_and_Resources/ESIP_HowToGuide_V2_2019.pdf" {...ext}>Energy Savings Improvement Program</a>,
    which requires every year to be cash-positive. The state adds <button class="doc" data-doc="adi">$110 per megawatt-hour for 15 years</button> for rooftop and canopy systems under 1 megawatt.
  </p>
  <p>
    The federal clean electricity investment credit also applies, and local governments can take it as cash, as long
    as the system is <a href="https://blogs.law.columbia.edu/climatechange/2025/07/07/the-one-big-beautiful-bill-act-considerations-for-cities-and-community-partners/" {...ext}>running by December 31, 2027</a>.
    That deadline covers any project starting construction after July 4, 2026, which includes ours.
  </p>

  <h2>It’s the Right Thing to Do</h2>
  <p>
    New Jersey has warmed about 4°F since 1900, twice the global average, according to the <a href="https://njclimateresourcecenter.rutgers.edu/new-jerseys-temperatures-rise-by-4-degrees-fahrenheit-twice-the-global-average-since-1900/" {...ext}>state climatologist’s office</a>.
    Ida’s flooding killed 30 people in the state in 2021, four of them <a href="https://cbsnews.com/newyork/news/elizabeth-nj-ida-flooding-victims-vigil" {...ext}>next door in Elizabeth</a>.
  </p>
  <figure class="photo">
    <img
      src="/solar/kenilworth-106.jpg"
      width="2047"
      height="1537"
      loading="lazy"
      alt="A roadside business sign on North Michigan Avenue in Kenilworth with a red digital thermometer reading 106 degrees above a tall OPEN sign, trees and a delivery truck behind it."
    />
    <figcaption>Extreme temperatures on N. Michigan Ave. in Kenilworth, July 2026. Photo by Eliot Caroom.</figcaption>
  </figure>

  <h2>Ask Our Candidates</h2>
  <p>Election day is November 3, 2026.</p>

  <h3>The Race for Mayor</h3>
  <ul class="ballot lead">
    {races[0].seats.map((c) => (
      <li><span class="cand">{c.name}</span> <span class="party">{c.party}{c.note ? `, ${c.note}` : ''}</span></li>
    ))}
  </ul>

  <h3>Borough Council</h3>
  {races.slice(1).map((r) => (
    <div class="race">
      <p class="office">{r.office.replace('Borough Council, ', '')}</p>
      <ul class="ballot">
        {r.seats.map((c) => (
          <li><span class="cand">{c.name}</span> <span class="party">{c.party}</span></li>
        ))}
      </ul>
    </div>
  ))}

  <h3>What to Ask Them</h3>
  <ol class="asks">
    {questions.map((q) => <li>{q}</li>)}
  </ol>

  {docs.map((d) => (
    <dialog class="sidecar" id={`doc-${d.id}`} aria-labelledby={`doc-${d.id}-t`}>
      <div class="sc-head">
        <p class="sc-kind">Source document</p>
        <button class="sc-close" type="button" aria-label="Close">close</button>
      </div>
      <h3 id={`doc-${d.id}-t`}>{d.title}</h3>
      <p class="sc-where">{d.where}</p>
      <table class="sc-rows">
        <tbody>
          {d.rows.map(([a, b]) => (
            <tr><th scope="row">{a}</th><td class="num">{b}</td></tr>
          ))}
        </tbody>
      </table>
      {d.note && <p class="sc-note">{d.note}</p>}
      <p><a href={d.href} {...ext}>Open the full PDF</a></p>
    </dialog>
  ))}

  <dialog class="sidecar" id="doc-all" aria-labelledby="doc-all-t">
    <div class="sc-head">
      <p class="sc-kind">Source documents</p>
      <button class="sc-close" type="button" aria-label="Close">close</button>
    </div>
    <h3 id="doc-all-t">Where the Chart’s Numbers Come From</h3>
    <p class="sc-where">
      Each budget reports the previous year’s spending next to its own appropriation, on Sheet 17, Current Fund,
      Unclassified, line 31-430-2, Electricity, “Paid or Charged.” 2023 comes from that year’s audit, because the 2024
      budget is posted only as scanned images.
    </p>
    <table class="sc-rows">
      <tbody>
        {bars.filter((b) => b.doc).map((b) => {
          const d = docs.find((x) => x.id === b.doc)!;
          return (
            <tr>
              <th scope="row">{b.year}{b.budgeted ? ' (budgeted)' : ''}</th>
              <td><a href={d.href} {...ext}>{d.title.replace('Roselle Park ', '')}</a></td>
            </tr>
          );
        })}
      </tbody>
    </table>
    {showRates && (
      <>
        <h3 class="sc-sub">Rate Lines</h3>
        <p class="sc-where">
          PSE&amp;G’s filed tariffs, as recorded in the U.S. Utility Rate Database. Each year’s point is the average of
          the rates in effect that year, weighted by days.
        </p>
        <p><button class="doc" data-doc="pseg">Every filing behind the lines</button></p>
      </>
    )}
  </dialog>

  {showRates && (
    <dialog class="sidecar" id="doc-pseg" aria-labelledby="doc-pseg-t">
      <div class="sc-head">
        <p class="sc-kind">Source documents</p>
        <button class="sc-close" type="button" aria-label="Close">close</button>
      </div>
      <h3 id="doc-pseg-t">PSE&amp;G Tariff Filings</h3>
      <p class="sc-where">
        Bundled energy rate (delivery plus PSE&amp;G’s default supply), base/winter tier, sales tax included, in cents per
        kilowatt-hour. Commercial is Rate Schedule GLP, General Lighting and Power, and excludes its separate demand
        charge; residential is Rate Schedule RS. Each rate holds until the next filing.
      </p>
      <table class="sc-rows">
        <thead><tr><th>Effective</th><th class="num">Commercial</th><th class="num">Residential</th><th>Filing</th></tr></thead>
        <tbody>
          {filings.map((f) => (
            <tr>
              <th scope="row">{longDate(f.eff)}</th>
              <td class="num">{f.glp.toFixed(2)}¢</td>
              <td class="num">{f.rs.toFixed(2)}¢</td>
              <td><a href={f.src} {...ext}>PDF</a></td>
            </tr>
          ))}
        </tbody>
      </table>
      <p class="sc-note">
        Retrieved from the <a href="https://apps.openei.org/USURDB/?utilRateFinder=PSEG" {...ext}>U.S. Utility Rate Database</a> (NREL / OpenEI). The 2019 and 2021 filings are recorded under PSE&amp;G’s general tariff
        address, which may now open a later version.
      </p>
      <p><a href="/solar/pseg-rates/">Full rate history since 2016</a> →</p>
    </dialog>
  )}
</Base>

<style>
  h3 { font-size: 1.2rem; margin: 1.75rem 0 0.5rem; }
  .ballot { list-style: none; padding: 0; margin: 0 0 1rem; border-top: 1px solid var(--rule); }
  .ballot li { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; padding: 0.5rem 0; border-bottom: 1px solid var(--rule); }
  .ballot .cand { font-weight: 600; color: var(--head); }
  .ballot .party { font: 0.8125rem var(--mono); color: var(--muted); text-align: right; }
  .ballot.lead .cand { font-size: 1.45rem; }
  .ballot.lead li { padding: 0.75rem 0; }
  .office { margin: 1rem 0 0.25rem; font: 0.8125rem var(--mono); color: var(--muted); text-transform: uppercase; letter-spacing: 0.04em; }

  .photo { margin: 1.5rem 0; }
  .photo img { display: block; width: 100%; height: auto; }
  .photo figcaption { font-size: 1rem; color: var(--muted); margin-top: 0.4rem; }

  /* this page is more formal: headings keep their title case */
  h1, h2, h3 { text-transform: none; }

  /* inline trigger for a source that opens in the side panel */
  .doc {
    font: inherit;
    color: var(--accent);
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    text-decoration: underline dotted;
    text-underline-offset: 0.15em;
  }
  .doc::after { content: ' ⧉'; font-size: 0.75em; color: var(--muted); }
  .doc:hover { text-decoration-style: solid; }

  /* spending chart: HTML columns so labels stay full size on phones */
  .spend { margin: 1.5rem 0 1.75rem; --bar: #2d5061; --grid: rgba(52, 54, 31, 0.18); }
  :global(:root[data-theme='dark']) .spend { --bar: #cdd494; --grid: rgba(214, 228, 235, 0.2); }
