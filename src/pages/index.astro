---
import Base from '../layouts/Base.astro';

const links = [
  { href: '/projects/', label: 'Projects' },
  { href: '/work/', label: 'Work' },
  { href: '/links/', label: 'Links' },
  { href: '/about/', label: 'About' },
];
---
<Base home>
  <h1 class="name">Eliot<br />Caroom</h1>
  <ul class="links">
    {links.map((l) => (
      <li><a href={l.href}>{l.label}</a></li>
    ))}
  </ul>
  <div class="badges">
  <a class="badge badge-highlight" href="/solar/">
    <span class="badge-kicker">Roselle Park, NJ</span>
    <span class="badge-title">Common Sense Solar Savings</span>
    <span class="badge-cta">see the case →</span>
  </a>
  <a class="badge" href="https://www.waituntil8th.org/take-the-pledge" target="_blank" rel="noopener">
    <span class="badge-kicker">Roselle Park parents</span>
    <span class="badge-title">Wait Until 8th</span>
    <span class="badge-cta">take the pledge ↗</span>
  </a>
  </div>
  <p class="minor"><a href="/archive/">archive</a> · <a href="/rss.xml">rss</a></p>
</Base>
