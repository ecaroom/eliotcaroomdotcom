---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('writing', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<Base title="Writing">
  <h1>Writing</h1>
  {posts.length === 0 ? (
    <p class="muted">First posts coming soon.</p>
  ) : (
    <ul class="list">
      {posts.map((post) => (
        <li>
          <time datetime={post.data.date.toISOString()}>
            {post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })}
          </time>
          <a href={`/writing/${post.id}/`}>{post.data.title}</a>
          <div class="muted">{post.data.summary}</div>
        </li>
      ))}
    </ul>
  )}
</Base>
