---
import Base from '../layouts/Base.astro';

// Newest first. External links get ext: true.
const projects = [
  {
    name: 'Wait Until 8th: Roselle Park, NJ',
    href: 'https://www.waituntil8th.org/faqs',
    ext: true,
    year: '2026',
    summary:
      'Sharing the Wait Until 8th pledge with fellow Roselle Park parents: Solidarity between parents to give our kids smartphone-free childhoods through elementary and middle school. The pledge covers only smartphones with web and social, and activates once 10 families in a grade sign up.',
  },
  {
    name: 'Accelerating solar for Roselle Park',
    href: '/solar/',
    ext: false,
    year: '2026',
    summary:
      'Evidence for why Roselle Park\'s mayoral candidates should support solar, starting with a decade of PSE&G electricity rates.',
  },
  {
    name: 'Climbing accidents',
    href: 'https://github.com/ecaroom/climbing-accidents',
    ext: true,
    year: '2020',
    summary:
      'Tagged 2,770 American Alpine Club accident reports from 1990 to 2019 to find patterns by discipline, experience, time of day and more. Published in Rock and Ice.',
  },
];
---
<Base title="Projects">
  <h1>Projects</h1>
  <table class="projects">
    <thead>
      <tr><th scope="col">project</th><th scope="col">what</th><th scope="col">year</th></tr>
    </thead>
    <tbody>
      {projects.map((p) => (
        <tr>
          <th scope="row"><a href={p.href} class={p.ext ? 'ext-inline' : undefined}>{p.name}</a></th>
          <td>{p.summary}</td>
          <td class="year">{p.year}</td>
        </tr>
      ))}
    </tbody>
  </table>
</Base>
