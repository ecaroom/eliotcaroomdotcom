---
import Base from '../layouts/Base.astro';

// Newest first. External links get ext: true.
const projects = [
  {
    name: 'Wait Until 8th: Roselle Park, NJ',
    href: 'https://www.waituntil8th.org/take-the-pledge',
    ext: true,
    year: '2026',
    summary:
      'Sharing the Wait Until 8th pledge with fellow Roselle Park parents: Solidarity between parents to give our kids smartphone-free childhoods through elementary and middle school. The pledge covers only smartphones with web and social, and activates once 10 families in a grade sign up.',
  },
  {
    name: 'Common sense solar savings for Roselle Park, NJ',
    href: '/solar/',
    ext: false,
    year: '2026',
    summary:
      'Roselle Park will benefit from adding solar to borough properties. It\'s the right financial choice to hedge against rising electric rates, and the right thing to do as climate causes worsening damage in New Jersey and beyond.',
  },
  {
    name: 'Climbing accidents',
    href: 'https://github.com/ecaroom/climbing-accidents',
    ext: true,
    year: '2020',
    summary:
      'Tagged 2,770 American Alpine Club accident reports from 1990 to 2019 to find patterns by discipline, experience, time of day and more. Published in Rock and Ice.',
  },
  {
    name: 'Left Bank ’66',
    href: '/left-bank-66/',
    ext: false,
    year: '2013',
    summary:
      'Executive producer of an album made from a 1966 live recording of five Baltimore jazz musicians, including Mickey Fields and Walter Namuth. The tape sat in storage for 45 years; a Kickstarter campaign paid for its release.',
  },
];
---
<Base title="Projects">
  <h1>Projects</h1>
  <table class="projects">
    <thead>
      <tr><th scope="col">project</th><th scope="col">what</th><th scope="col">year</th></tr>
    </thead>
    <tbody>
      {projects.map((p) => (
        <tr>
          <th scope="row"><a href={p.href} class={p.ext ? 'ext-inline' : undefined} target={p.ext ? '_blank' : undefined} rel={p.ext ? 'noopener' : undefined}>{p.name}</a></th>
          <td>{p.summary}</td>
          <td class="year">{p.year}</td>
        </tr>
      ))}
    </tbody>
  </table>
</Base>
