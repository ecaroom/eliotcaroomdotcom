---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = 'Eliot Caroom: career, projects, writing and podcasts.' } = Astro.props;
const pageTitle = title ? `${title} | Eliot Caroom` : 'Eliot Caroom';
const path = Astro.url.pathname;

const nav = [
  { href: '/career/', label: 'Career' },
  { href: '/projects/', label: 'Projects' },
  { href: '/writing/', label: 'Writing' },
  { href: '/podcasts/', label: 'Podcasts' },
  { href: '/archive/', label: 'Archive' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(path, Astro.site)} />
    <link rel="alternate" type="application/rss+xml" title="Eliot Caroom: Writing" href="/rss.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
  </head>
  <body>
    <header class="site">
      <div class="wrap">
        <a class="name" href="/">Eliot Caroom</a>
        <nav aria-label="Main">
          <ul>
            {nav.map((item) => (
              <li>
                <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </header>
    <main class="wrap">
      <slot />
    </main>
    <footer class="site">
      <div class="wrap">
        <a href="/rss.xml">RSS</a>
      </div>
    </footer>
  </body>
</html>
