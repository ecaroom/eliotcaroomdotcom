---
import '@fontsource/eb-garamond/400.css';
import '@fontsource/eb-garamond/400-italic.css';
import '@fontsource/eb-garamond/600.css';
import '@fontsource/eb-garamond/700.css';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  home?: boolean;
}

const { title, description = 'Projects, writing and podcasts by Eliot Caroom.', home = false } = Astro.props;
const pageTitle = title ? `${title} | Eliot Caroom` : 'Eliot Caroom';
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(path, Astro.site)} />
    <link rel="alternate" type="application/rss+xml" title="Eliot Caroom: Writing" href="/rss.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <script is:inline>
      try {
        const t = localStorage.getItem('theme');
        if (t) document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
  </head>
  <body>
    <header class="band">
      <div class="wrap topbar">
        {home ? <span class="version">v.3</span> : <a class="back" href="/">← Eliot Caroom</a>}
        <button class="mode" type="button" aria-label="Toggle light or dark mode">mode</button>
      </div>
    </header>
    <div class="wrap">
      <main>
        <slot />
      </main>
    </div>
    <script is:inline>
      document.querySelector('.mode').addEventListener('click', () => {
        const root = document.documentElement;
        const dark = root.dataset.theme
          ? root.dataset.theme === 'dark'
          : matchMedia('(prefers-color-scheme: dark)').matches;
        root.dataset.theme = dark ? 'light' : 'dark';
        try { localStorage.setItem('theme', root.dataset.theme); } catch (e) {}
      });
    </script>
  </body>
</html>
